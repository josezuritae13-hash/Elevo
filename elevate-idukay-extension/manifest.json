{
  "manifest_version": 3,
  "name": "Elevate: copiar notas de Idukay",
  "version": "0.4.0",
  "description": "Copia tus actividades y calificaciones de Idukay en formato JSON para importarlas en Elevate.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "Copiar notas de Idukay",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
